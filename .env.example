# ollama_glm_proxy.py reads these from the process environment.
# The proxy does NOT load this file automatically -- export them in your
# shell, or set them in the MCP `env` block, before launching.

# REQUIRED. Key for the upstream OpenAI-compatible provider.
# Groq (free tier): console.groq.com   |   Z.ai: z.ai
GLM_API_KEY=

# Upstream base URL. Default: https://api.z.ai/api/paas/v4
# For Groq's free tier use: https://api.groq.com/openai/v1
GLM_API_BASE=

# Model name, forwarded verbatim upstream. Default: glm-5.2
# For Groq's free tier use: openai/gpt-oss-120b
GLM_MODEL=

# Real local Ollama, used for embeddings passthrough. Default: http://127.0.0.1:11434
REAL_OLLAMA_URL=

# Where the proxy listens. Defaults: 127.0.0.1 / 11435
PROXY_HOST=
PROXY_PORT=

# Per-request upstream timeout in seconds. Default: 300
GLM_TIMEOUT=

# ask_claude_mcp.py reads these.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=
